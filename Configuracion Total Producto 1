configure terminal
hostname R1-Core
no ip domain-lookup
ip domain-name itla.local
service password-encryption
enable secret onel

username onel privilege 15 secret onel

banner motd #
*****************************************************
* Solo acceso autorizado  -  EQUIPO 1             *
*****************************************************
#

line console 0
 password onel
 login local
 logging synchronous
line vty 0 4
 password onel
 login local
 transport input telnet ssh
exit

ipv6 unicast-routing

! --- CONFIGURACION NAT PARA SALIDA A INTERNET ---
access-list 1 permit 172.16.0.0 0.15.255.255
ip nat inside source list 1 interface e0/2 overload

interface e0/0
 no shutdown
 ip address 172.16.10.169 255.255.255.252
 ipv6 address 2001:25:16:C::1/64
 ipv6 enable
 ipv6 ospf 1 area 0
 ip nat inside
 duplex full
 description Enlace-L3-a-SWM1

interface e0/1
 no shutdown
 ip address 172.16.10.173 255.255.255.252
 ipv6 address 2001:25:16:D::1/64
 ipv6 enable
 ipv6 ospf 1 area 0
 ip nat inside
 duplex full
 description Enlace-L3-a-SWM2

interface e0/2
 no shutdown
 ip address 172.16.10.165 255.255.255.252
 ipv6 address 2001:25:16:B::1/64
 ipv6 enable
 ipv6 ospf 1 area 0
 ip nat outside
 description Enlace-a-ISP

interface s1/0
 no shutdown
 ip address 172.16.10.161 255.255.255.252
 ipv6 address 2001:25:16:A::1/64
 ipv6 enable
 ipv6 ospf 1 area 0
 ip nat inside
 clock rate 64000
 description Serial-WAN-a-R2

interface Loopback0
